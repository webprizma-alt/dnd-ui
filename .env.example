# GEMINI_API_KEY: Required for Gemini AI API calls (free AIza... key works for gemini-3.1-flash-lite vision;
# paid tier key required for Nano Banana direct image generation).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# IMAGE_PROVIDER: "auto" (default: uses Cloudflare if configured, else Gemini), "cloudflare", or "gemini"
IMAGE_PROVIDER="auto"

# Cloudflare Workers AI (Free tier: 10,000 Neurons/day for @cf/black-forest-labs/flux-1-schnell)
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_API_TOKEN=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
